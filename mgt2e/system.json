{
  "id": "mgt2e-piggy",
  "title": "Mongoose Traveller 2e (Piggy Build)",
  "description": "A system for Mongoose Traveller 2e. This includes rules specific to this version of Traveller.",
  "version": "0.22.1.1",
  "compatibility": {
    "minimum": 13,
    "verified": 14,
    "maximum": 14
  },
  "authors": [
    {
      "name": "Samuel Penn",
      "url": "https://www.notasnark.net/",
      "email": "sam@notasnark.net",
      "discord": "notasnark"
    },
    {
      "name": "Morgan Haldane"
    }
  ],
  "esmodules": ["module/mgt2.mjs" ],
  "styles": [
    "css/mgt2.css", "css/history.css", "css/items.css", "css/journals.css",
    "css/software.css", "css/world.css", "css/npc.css", "css/chat.css",
    "css/mgt2e.css"
  ],
  "background": "systems/mgt2e-piggy/images/traveller.webp",
  "scripts": [ ],
  "packs": [
    {
      "name": "base-items",
      "label": "MgT2e Base Items",
      "system": "mgt2e-piggy",
      "module": "mgt2e-piggy",
      "path": "packs/base-items",
      "type": "Item"
    },
    {
      "name": "base-actors",
      "label": "MgT2e Base Actors",
      "system": "mgt2e-piggy",
      "module": "mgt2e-piggy",
      "path": "packs/base-actors",
      "type": "Actor"
    },
    {
      "name": "traveller-docs",
      "label": "MgT2e Base Docs",
      "system": "mgt2e-piggy",
      "module": "mgt2e-piggy",
      "path": "packs/traveller-docs",
      "type": "JournalEntry"
    },
    {
      "name": "base-macros",
      "label": "MgT2e Base Macros",
      "system": "mgt2e-piggy",
      "module": "mgt2e-piggy",
      "path": "packs/base-macros",
      "type": "Macro"
    },
    {
      "name": "base-scenes",
      "label": "MgT2e Base Scenes",
      "system": "mgt2e-piggy",
      "module": "mgt2e-piggy",
      "path": "packs/base-scenes",
      "type": "Scene"
    },
    {
      "name": "base-tables",
      "label": "MgT2e Base Tables",
      "system": "mgt2e-piggy",
      "module": "mgt2e-piggy",
      "path": "packs/base-tables",
      "type": "RollTable"
    }
  ],
  "packFolders": [
    {
      "name": "MgT2e",
      "color": "#804040",
      "sorting": "a",
      "ownership": {
        "PLAYER": "OBSERVER"
      },
      "packs": [
        "base-items", "base-actors", "traveller-docs", "base-macros", "base-scenes", "base-tables"
      ]
    }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "fr",
      "name": "French",
      "path": "lang/fr.json"
    },
    {
      "lang": "es",
      "name": "Español",
      "path": "lang/es.json"
    },
    {
      "lang": "pt-BR",
      "name": "Português (Brasil)",
      "path": "lang/pt-BR.json"
     }
  ],
  "socket": true,
  "grid": {
    "distance": 1.5,
    "units": "m"
  },
  "primaryTokenAttribute": "hits",
  "secondaryTokenAttribute": null,
  "url": "https://github.com/MorganBard/traveller-foundryvtt/",
  "manifest": "https://github.com/MorganBard/traveller-foundryvtt/releases/download/v0.22.1.1/system.json",
  "download": "https://github.com/MorganBard/traveller-foundryvtt/releases/download/v0.22.1.1/mongoose-traveller.zip",
  "license": "https://github.com/MorganBard/traveller-foundryvtt/raw/v0.22.1.1/LICENSE.txt"
}
